// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "context_servers": {
    "postgres-context-server": {
      "enabled": true,
      "remote": false,
      "settings": {}
    }
  },
  "agent_servers": {
    "Claude Personal": {
      "default_config_options": {
        "model": "opus",
        "fast": false,
        "effort": "medium",
        "mode": "acceptEdits"
      },
      "type": "custom",
      "command": "npx",
      "args": ["-y", "@agentclientprotocol/claude-agent-acp"]
    },
    "Claude Work": {
      "default_config_options": {
        "model": "opus",
        "fast": false,
        "effort": "medium",
        "mode": "acceptEdits"
      },
      "type": "custom",
      // sh -c da bi $HOME važio i na Linuxu i na Mac-u
      "command": "sh",
      "args": [
        "-c",
        "CLAUDE_CONFIG_DIR=\"$HOME/.claude-work\" exec npx -y @agentclientprotocol/claude-agent-acp"
      ]
    }
  },
  "agent": {
    "play_sound_when_agent_done": "when_hidden",
    "auto_compact": {
      "threshold": "40%"
    },
    "dock": "right",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-5-latest"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "base_keymap": "SublimeText",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": "Ayu Dark",
}
