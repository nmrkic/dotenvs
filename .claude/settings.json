{
  "permissions": {
    "allow": [
        "Bash(git diff:*)",
	"Bash(git status:*)",
	"Bash(git log:*)"
    ],
    "deny": [
      "Bash(docker run *)",
      "Bash(docker start *)",
      "Bash(docker stop *)",
      "Bash(docker restart *)",
      "Bash(docker kill *)",
      "Bash(docker rm *)",
      "Bash(docker exec *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(docker compose start *)",
      "Bash(docker compose stop *)",
      "Bash(docker compose restart *)",
      "Bash(docker compose exec *)",
      "Bash(docker compose run *)",
      "Bash(docker compose build *)",
      "Bash(docker-compose *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git revert *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git stash *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git branch *)",
      "Bash(git tag *)",
      "Bash(git cherry-pick *)",
      "Bash(git config *)",
      "Bash(git remote *)",
      "Bash(git clone *)",
      "Bash(git init *)",
      "Bash(git am *)",
      "Bash(git apply *)",
      "Bash(git gc *)",
      "Bash(git worktree *)",
      "Bash(git submodule *)"
    ]
  },
  "tui": "fullscreen",
  "theme": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
