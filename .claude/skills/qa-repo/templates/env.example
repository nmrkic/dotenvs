# Shape reference only. The real file lists every variable the project uses
# (see SKILL.md). Copy to .env; fill in the empty values you need.

# =============================================================================
# QA deployment (used by docker-compose.yml and the Makefile)
# =============================================================================
REGISTRY=reg.bwl.rs/__PROJECT__
SHARED_REGISTRY=reg.bwl.rs/shared
DOCKER_CONTAINER_SUFFIX=__PROJECT___qa
# Image tag to run. `make start issue=ABC-12` overrides it.
APP_VERSION=dev
# Frontend image tag; empty = same as APP_VERSION.
FRONT_APP_VERSION=
# Only for `make run_scheduler method=... service=...`
METHOD=
SERVICE=

# =============================================================================
# Common
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=info
DEVELOP=false

# =============================================================================
# PostgreSQL (local container, not a secret)
# =============================================================================
POSTGRES_USER=__PROJECT__
POSTGRES_PASSWORD=__PROJECT__
POSTGRES_DB=__PROJECT__
DATABASE_URL=postgresql+psycopg://__PROJECT__:__PROJECT__@postgres:5432/__PROJECT__

# =============================================================================
# RabbitMQ (local container, not a secret)
# =============================================================================
RABBITMQ_DEFAULT_USER=rabbit
RABBITMQ_DEFAULT_PASS=rabbit
RABBITMQ_DEFAULT_VHOST=rabbit
RABBIT_URL=amqp://rabbit:rabbit@rabbit:5672/rabbit

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# rest_api
# =============================================================================
# Local-only signing keys: any value works, these protect nothing outside
# this machine.
JWT_SECRET=local-qa-jwt-secret
REFRESH_JWT_SECRET=local-qa-refresh-jwt-secret
JWT_ALGORITHM=HS256

# =============================================================================
# ai
# =============================================================================
# SECRET - real provider key, ask the team. Empty = AI features are off.
OPENAI_API_KEY=
AI_MODEL=openai/gpt-4.1-mini

# =============================================================================
# notify
# =============================================================================
# Local mail catcher. For real sending set the SMTP host and the two values
# below (SECRET - ask the team).
EMAIL_HOST=mail
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_PASSWORD=
